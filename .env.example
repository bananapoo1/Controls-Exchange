# ---------- Runtime ----------
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=*
COOKIE_SECURE=false
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760

# Local development defaults to SQLite if DATABASE_URL is blank.
DATABASE_URL=
DATABASE_PATH=data/controls_exchange.db

# Production example:
# DATABASE_URL=postgresql://controlsexchange:strong-password@db:5432/controlsexchange

# ---------- Transactional email ----------
# Supported: log, resend, smtp. 'log' writes to data/email_outbox.log.
EMAIL_PROVIDER=log
EMAIL_FROM=Controls Exchange <hello@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# ---------- Monitoring ----------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- Backups ----------
BACKUP_DIR=backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=14

# ---------- Development seed data ----------
SEED_ADMIN=true
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@controlsexchange.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Phase 2 inventory freshness windows
INVENTORY_FRESH_DAYS=30
INVENTORY_AGING_DAYS=60
INVENTORY_EXPIRY_DAYS=90

# ---------- Phase 3 inventory integrations ----------
# Separate random key used to encrypt SFTP/API credentials at rest. Required in production.
INTEGRATION_ENCRYPTION_KEY=replace-with-another-random-secret-at-least-32-characters
FEED_WORKER_INTERVAL_SECONDS=60

# Optional inbound-email mailbox. Configure a catch-all/plus-address mailbox so
# messages to imports+<token>@yourdomain reach this account.
INVENTORY_IMPORT_EMAIL_DOMAIN=
INVENTORY_IMPORT_IMAP_HOST=
INVENTORY_IMPORT_IMAP_PORT=993
INVENTORY_IMPORT_IMAP_USER=
INVENTORY_IMPORT_IMAP_PASSWORD=
INVENTORY_IMPORT_IMAP_SSL=true
INVENTORY_IMPORT_IMAP_FOLDER=INBOX
# ---------- Phase 4 photo identification ----------
# Optional. Without this key, Photo ID still supports local matching from typed visible-label text.
OPENAI_API_KEY=
PHOTO_ID_MODEL=gpt-5.6-luna
PHOTO_ID_MAX_BYTES=8388608
AI_SOURCING_ENABLED=true
AI_SOURCING_MODEL=gpt-5.6-luna

# ---------- Phase 5 commercial / billing ----------
# Founding programme: verified suppliers get 90 days; set false later to use STANDARD_TRIAL_DAYS.
FOUNDING_TRIAL_ENABLED=true
FOUNDING_TRIAL_DAYS=90
STANDARD_TRIAL_DAYS=30

# Stripe is optional during local development/manual founding trials.
# Use sk_test_/whsec_ values first and create recurring GBP prices matching the plan catalogue.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=http://127.0.0.1:8000/billing
# At the end of a Stripe-backed no-card trial: pause (recommended), cancel, or create_invoice.
STRIPE_TRIAL_END_BEHAVIOR=pause
# Optional Stripe sandbox Test Clock ID for accelerated billing tests. NEVER set in production.
STRIPE_TEST_CLOCK_ID=
STRIPE_PRICE_SUPPLIER_STARTER_MONTHLY=
STRIPE_PRICE_SUPPLIER_STARTER_ANNUAL=
STRIPE_PRICE_SUPPLIER_PRO_MONTHLY=
STRIPE_PRICE_SUPPLIER_PRO_ANNUAL=
STRIPE_PRICE_SUPPLIER_PREMIUM_MONTHLY=
STRIPE_PRICE_SUPPLIER_PREMIUM_ANNUAL=
STRIPE_PRICE_MANUFACTURER_MONTHLY=
STRIPE_PRICE_MANUFACTURER_ANNUAL=

# ---------- Phase 6 market intelligence / API ----------
# Privacy thresholds. Do not lower casually in production: they prevent reverse-engineering
# individual buyer demand or competitor quotes from sparse marketplace data.
INTELLIGENCE_MIN_DEMAND_EVENTS=5
INTELLIGENCE_MIN_BUYER_COMPANIES=3
INTELLIGENCE_MIN_QUOTE_SAMPLES=5
INTELLIGENCE_MIN_QUOTE_SUPPLIERS=3
INTELLIGENCE_MIN_QUOTE_BUYER_COMPANIES=3
INTELLIGENCE_MAX_CONTRIBUTOR_SHARE=0.5
# Repeated identical searches by the same company inside this window count once for demand intelligence.
SEARCH_DEMAND_DEDUP_MINUTES=30
# API keys are additionally capped by the current plan in billing.py.
API_DEFAULT_RATE_PER_HOUR=1000
API_MAX_RATE_PER_HOUR=10000

# Phase 7 — procurement / order workflow
ORDER_DOCUMENT_DIR=/app/data/order_documents
ORDER_DOCUMENT_MAX_BYTES=10485760
WEBHOOK_WORKER_INTERVAL_SECONDS=20
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_SECONDS=15
# Keep false on public deployments unless you intentionally need callbacks to an internal network.
ALLOW_PRIVATE_WEBHOOK_HOSTS=false
